.content {
  position: relative;
  min-height: 100vh;
  background-color: #e9d7be;
  padding-top: 20rpx;
  box-sizing: border-box;
}

.items-container {
  padding: 20rpx;
  position: relative;
  z-index: 1;
}

.item-wrapper {
  margin-bottom: 40rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.item-title {
  padding: 20rpx;
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  line-height: 1.4;
}

.image-container {
  width: 100%;
  height: 420rpx;
  overflow: hidden;
  position: relative;
}

.item-image {
  width: 100%;
  display: block;
}

.card-action-bar {
  width: 100%;
  display: flex;
  justify-content: space-around;
  align-items: center;
  padding: 16rpx 0;
  border-top: 1rpx solid #f0f0f0;
  border-bottom: 1rpx solid #f0f0f0;
  background-color: #ffffff;
}

.card-action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1;
  gap: 8rpx;
}

.card-action-item:active {
  transform: scale(0.95);
  opacity: 0.7;
}

.card-action-button {
  background: transparent;
  border: none;
  padding: 0;
  line-height: normal;
}

.card-action-button::after {
  border: none;
}

.action-text-large {
  font-size: 42rpx;
  line-height: 1;
}

.action-text {
  font-size: 24rpx;
  color: #666;
}

.comment-input-container {
  background-color: #ffffff;
  border-top: 1rpx solid #f0f0f0;
  padding: 16rpx;
  display: flex;
  gap: 12rpx;
}

.comment-input {
  flex: 4;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  padding: 10rpx 12rpx;
  font-size: 26rpx;
  box-sizing: border-box;
  height: 72rpx;
}

.comment-btn {
  flex: 1;
  background-color: #1aad19;
  color: white;
  border: none;
  border-radius: 8rpx;
  padding: 0 16rpx;
  font-size: 26rpx;
  min-width: 80rpx;
  height: 72rpx;
  line-height: 72rpx;
}

.comments-list {
  background-color: #ffffff;
  padding: 18rpx 16rpx;
}

.comments-header {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  padding: 8rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  margin-bottom: 12rpx;
}

.comment-item {
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 10rpx;
}

.comment-item:last-child {
  border-bottom: none;
}

.comment-content {
  flex: 1;
}

.comment-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background-color: #f0f0f0;
  flex-shrink: 0;
}

.comment-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 6rpx;
}

.comment-author {
  font-size: 24rpx;
  color: #333;
  font-weight: 600;
}

.comment-text {
  font-size: 24rpx;
  color: #333;
  line-height: 1.6;
  word-break: break-word;
}

.comment-time {
  font-size: 22rpx;
  color: #999;
}

.comment-delete {
  color: #ff6b6b;
  padding: 4rpx 8rpx;
  border: 1rpx solid #ff6b6b;
  border-radius: 4rpx;
  white-space: nowrap;
  align-self: flex-start;
}

.comment-delete-icon {
  font-size: 22rpx;
  line-height: 1;
}

.search-container {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 12rpx;
  padding: 8rpx;
  background-color: #f5f5f5;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.1);
}

.search-input {
  flex: 5;
  padding: 8rpx 12rpx;
  font-size: 32rpx;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  outline: none;
}

.search-button {
  flex: 1;
  margin-left: 8rpx;
  padding: 8rpx 16rpx;
  font-size: 32rpx;
  color: #fff;
  background-color: #b55400;
  border: none;
  border-radius: 8rpx;
  cursor: pointer;
  transition: background-color 0.3s;
}

.search-button:hover {
  background-color: #b55400;
}

.more-hint {
  text-align: center;
  color: #666;
  font-size: 32rpx;
  font-weight: 600;
  padding: 10rpx 0 40rpx;
  position: relative;
  z-index: 1;
}