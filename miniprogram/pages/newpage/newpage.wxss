body, html {
  margin: 0;
  padding: 0;
  overflow-x: hidden;
}

.newpage-container {
  position: relative;
  width: 100%;
  height: 100vh;
  overflow: hidden;
}

.background-image {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: -1;
}

.content {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  height: 100vh;
  padding: 0 20rpx;
  box-sizing: border-box;
}

.top-image-wrapper {
  position: relative;
  width: 100%;
  margin-top: 0;
}

.top-image {
  width: 60%;
  display: block;
  margin: 80rpx auto 80rpx;
}

.image-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 10px;
  width: 95%;
  max-width: 500px;
  margin: 24rpx auto 0;
}

.grid-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 8px;
}

.grid-image {
  width: 140px;
  height: 140px;
  object-fit: contain;
  transition: transform 0.2s;
  border: none;
  min-height: 0;
}

.grid-image:active {
  transform: scale(0.9);
}

.grid-label {
  margin-top: 8px;
  font-size: 20px;
  color: #333;
  text-align: center;
  word-break: break-all;
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
  font-weight: bold;
}

.today-entry {
  position: fixed;
  right: 28rpx;
  bottom: 180rpx;
  z-index: 20;
  min-width: 150rpx;
  padding: 16rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(120, 78, 34, 0.92);
  color: #fff;
  font-size: 26rpx;
  text-align: center;
}

.today-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 50;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  box-sizing: border-box;
}

.today-popup {
  position: relative;
  width: 100%;
  max-width: 690rpx;
  height: 78vh;
  background: #fdf8f0;
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  padding: 28rpx 24rpx 20rpx;
  box-sizing: border-box;
}

.popup-close {
  position: absolute;
  right: 24rpx;
  top: 14rpx;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  text-align: center;
  line-height: 52rpx;
  font-size: 44rpx;
  color: #666;
}

.popup-title {
  text-align: center;
  font-size: 34rpx;
  font-weight: 700;
  color: #5f3a12;
  margin-bottom: 20rpx;
}

.popup-scroll {
  flex: 1;
  min-height: 0;
  padding: 0 6rpx;
}

.popup-section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #8c5c2d;
  margin-bottom: 12rpx;
}

.section-gap {
  margin-top: 22rpx;
}

.popup-line {
  font-size: 28rpx;
  color: #333;
  line-height: 1.75;
  white-space: pre-wrap;
  word-break: break-all;
}

.popup-actions {
  margin-top: 18rpx;
  display: grid;
  grid-template-columns: 1fr;
  gap: 14rpx;
}

.action-btn {
  background: #8c5c2d;
  color: #fff;
  border-radius: 14rpx;
  text-align: center;
  padding: 16rpx 8rpx;
  font-size: 24rpx;
}

.today-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
  width: 660px;
  height: 980px;
  opacity: 0;
  pointer-events: none;
}