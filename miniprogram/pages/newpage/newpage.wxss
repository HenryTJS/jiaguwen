body, html {
  margin: 0;
  padding: 0;
  overflow-x: hidden;
}

.newpage-container {
  position: relative;
  width: 100%;
  height: 100vh;
  overflow: hidden;
}

.background-image {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: -1;
}

.content {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  height: 100vh;
  padding: 0 20rpx;
  box-sizing: border-box;
}

.top-image-wrapper {
  position: relative;
  width: 100%;
  margin-top: 0;
}

.top-image {
  width: 100%;
  display: block;
  margin: 30rpx auto 0;
}

.oracle-title-image {
  position: absolute;
  top: 40rpx;
  left: 10%;
  width: 280rpx;
  display: block;
  z-index: 2;
}

.oracle-lines {
  position: absolute;
  left: 20rpx;
  bottom: 16rpx;
  z-index: 3;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.oracle-a {
  font-size: 54rpx;
  font-weight: 700;
  font-family: 'OracleKaiTi', 'Kaiti SC', 'STKaiti', 'KaiTi', 'BiauKai', 'DFKai-SB', '楷体', 'Songti SC', serif;
  text-align: left;
  margin-top: 0;
  line-height: 1.2;
  color: #d2691e;
}

.oracle-b {
  font-size: 54rpx;
  font-weight: 700;
  font-family: 'OracleKaiTi', 'Kaiti SC', 'STKaiti', 'KaiTi', 'BiauKai', 'DFKai-SB', '楷体', 'Songti SC', serif;
  text-align: left;
  margin-top: 0;
  line-height: 1.2;
  color: #d2691e;
}

.oracle-c {
  font-size: 54rpx;
  font-weight: 700;
  font-family: 'OracleKaiTi', 'Kaiti SC', 'STKaiti', 'KaiTi', 'BiauKai', 'DFKai-SB', '楷体', 'Songti SC', serif;
  text-align: left;
  margin-top: 0;
  line-height: 1.2;
  color: #d2691e;
}

.oracle-d {
  font-size: 54rpx;
  font-weight: 700;
  font-family: 'OracleKaiTi', 'Kaiti SC', 'STKaiti', 'KaiTi', 'BiauKai', 'DFKai-SB', '楷体', 'Songti SC', serif;
  text-align: left;
  margin-top: 0;
  line-height: 1.2;
  color: #d2691e;
}

.image-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 10px;
  width: 95%;
  max-width: 500px;
  margin: 24rpx auto 0;
}

.grid-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 8px;
}

.grid-image {
  width: 140px;
  height: 140px;
  object-fit: contain;
  transition: transform 0.2s;
  border: none;
  min-height: 0;
}

.grid-image:active {
  transform: scale(0.9);
}

.grid-label {
  margin-top: 8px;
  font-size: 20px;
  color: #333;
  text-align: center;
  word-break: break-all;
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
  font-weight: bold;
}