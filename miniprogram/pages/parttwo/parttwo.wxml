<view class="content">
  <!-- 搜索框 -->
  <view class="search-container">
    <input class="search-input" placeholder="请输入标题" bindinput="onSearchInput" />
    <button class="search-button" bindtap="onSearchTap">搜索</button>
  </view>
  
  <view class="items-container">
    <block wx:for="{{currentItems}}" wx:key="index">
      <view class="item-wrapper" bindtap="goToDetail" data-index="{{index}}">
        <!-- 图片容器 -->
        <view class="image-container">
          <image 
            class="item-image" 
            src="{{item.picture}}" 
            mode="widthFix"
          ></image>
        </view>

        <view class="item-title">{{item.text}}</view>

        <view class="card-action-bar" catchtap="noop">
          <view class="card-action-item" bindtap="toggleLike" data-key="{{item.text}}">
            <view class="action-text-large">{{item._ui.isLiked ? '❤️' : '🤍'}}</view>
            <text class="action-text">{{item._ui.likeCount}}</text>
          </view>
          <view class="card-action-item" bindtap="goToDetailComment" data-text="{{item.text}}" data-picture="{{item.picture}}">
            <view class="action-text-large">💬</view>
            <text class="action-text">{{item._ui.commentCount}}</text>
          </view>
          <button
            class="card-action-item card-action-button"
            open-type="share"
            data-text="{{item.text}}"
            data-picture="{{item.picture}}"
            bindtap="prepareShare"
          >
            <view class="action-text-large">🔄</view>
            <text class="action-text">转发</text>
          </button>
        </view>
      </view>
    </block>
  </view>
  <view class="more-hint">更多内容敬请期待</view>
</view>
